<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Product photos, captured via the camera intent. -->
    <external-files-path
        name="product_images"
        path="Pictures/" />
    <files-path
        name="internal_images"
        path="images/" />
    <cache-path
        name="cache_images"
        path="images/" />
    <!-- Generated CSV/PDF reports, shared through the system share sheet. -->
    <cache-path
        name="exports"
        path="exports/" />
</paths>
