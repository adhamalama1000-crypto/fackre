<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon. The system uses only the alpha channel and tints it a flat
  colour, so this is a single white silhouette with no gradients or layered fills: a box
  with a warning mark, readable at 24dp in the status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Open-topped box, cut away on the right to make room for the warning mark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,2 L21,7 L21,9.4 L19,9.4 L19,8.2 L12,12 L5,8.2 L5,17 L11,20.3 L11,22 L3,17.6 L3,7 Z" />

    <!-- Warning bar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15.3,11.2 L17.7,11.2 L17.7,17.2 L15.3,17.2 Z" />

    <!-- Warning dot: a closed circle built from two half arcs -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M16.5,18.6 A1.3,1.3 0 0,1 16.5,21.2 A1.3,1.3 0 0,1 16.5,18.6 Z" />
</vector>
