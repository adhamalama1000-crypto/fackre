<?xml version="1.0" encoding="utf-8"?>
<!--
  Rasid mark: an isometric cube — a packed box, the universal shorthand for stock — split
  into three faces. The amber top face is the brand accent and reads as the open/labelled
  side; the two white faces give depth with a single colour so the mark survives being
  scaled to a 24dp notification badge.

  Geometry is kept inside the adaptive-icon safe zone: every vertex is within 27 units of
  the 54,54 centre, comfortably inside the 33-unit radius that launcher masks may clip to,
  so no corner of the cube is shaved off by a circular or squircle mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top face (amber accent) -->
    <path
        android:fillColor="#F5A524"
        android:pathData="M54,28 L77,41 L54,54 L31,41 Z" />

    <!-- Left face -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M31,41 L54,54 L54,80 L31,67 Z" />

    <!-- Right face, dimmed to suggest a light source and separate the two sides -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.62"
        android:pathData="M77,41 L54,54 L54,80 L77,67 Z" />
</vector>
